{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Launch listener (ts-node)",
      "runtimeArgs": ["-r", "ts-node/register"],
      "program": "${workspaceFolder}/listener/listener.ts",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "protocol": "inspector",
      "stopOnEntry": false
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach to process (9229)",
      "port": 9229
    }
  ]
}
